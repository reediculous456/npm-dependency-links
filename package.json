{
  "name": "npm-package-page-links",
  "displayName": "npm Package Page Links",
  "icon": "images/icon.png",
  "description": "Open npm package pages directly from dependency names in package.json.",
  "version": "1.1.0",
  "publisher": "reediculous456",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reediculous456/npm-dependency-links.git"
  },
  "bugs": {
    "url": "https://github.com/reediculous456/npm-dependency-links/issues"
  },
  "homepage": "https://github.com/reediculous456/npm-dependency-links#readme",
  "keywords": [
    "npm",
    "dependencies",
    "package.json",
    "document-links",
    "open-vsx"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "npm Dependency Links",
      "properties": {
        "npmDependencyLinks.registryUrlPattern": {
          "type": "string",
          "default": "https://www.npmjs.com/package/{{pkg}}",
          "description": "URL pattern used for dependency links. The {{pkg}} token is replaced with the dependency package name."
        },
        "npmDependencyLinks.underlineOnlyWithModifier": {
          "type": "boolean",
          "default": false,
          "description": "Underline package names only while holding Command (macOS) or Ctrl. Clicking while that key is held, or Go to Definition, opens the package page. If the multi-cursor modifier is set to Command/Ctrl, hold Alt instead, matching Go to Definition."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "check": "npm test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:open-vsx": "ovsx publish",
    "publish:vscode": "vsce publish"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
